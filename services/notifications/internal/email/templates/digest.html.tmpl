<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><title>{{.Subject}}</title></head>
<body style="font-family: -apple-system, 'Segoe UI', sans-serif; color: #1f2328; max-width: 560px;">
<p>Hi {{.RecipientName}},</p>
<p>You have {{len .Items}} new notifications:</p>
<ul style="padding-left: 18px;">
{{- range .Items}}
<li style="margin-bottom: 12px;">
{{- if .Link}}<a href="{{.Link}}" style="font-weight: 600;">{{.Title}}</a>{{else}}<span style="font-weight: 600;">{{.Title}}</span>{{end}}
{{- if .Body}}<br><span style="color: #57606a; white-space: pre-wrap;">{{.Body}}</span>{{end}}
</li>
{{- end}}
</ul>
<p><a href="{{.InboxLink}}">See them all in Skein</a></p>
<hr style="border: none; border-top: 1px solid #d0d7de;">
<p style="font-size: 12px; color: #57606a;">You get this email because of your Skein notification settings. <a href="{{.SettingsLink}}">Change them</a>.</p>
</body>
</html>
