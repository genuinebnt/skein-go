{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memberships.schema.json",
  "title": "One line of memberships.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "user_id",
    "role",
    "joined_at",
    "removed_at",
    "invited_by"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "user_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "role": {
      "$ref": "common.schema.json#/$defs/workspaceRole"
    },
    "joined_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "removed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "invited_by": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
