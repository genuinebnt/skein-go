{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workspaces.schema.json",
  "title": "One line of workspaces.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "slug",
    "kind",
    "owner_id",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "anchor",
        "procedural",
        "stress-chain",
        "stress-hub",
        "stress-shapes"
      ]
    },
    "owner_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  }
}
