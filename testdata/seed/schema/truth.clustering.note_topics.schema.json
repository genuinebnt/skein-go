{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truth.clustering.note_topics.schema.json",
  "title": "One line of truth/clustering/note_topics.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "note_id",
    "workspace_id",
    "topic",
    "secondary_topic",
    "mix",
    "kind"
  ],
  "properties": {
    "note_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "topic": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/topic"
        },
        {
          "type": "null"
        }
      ]
    },
    "secondary_topic": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/topic"
        },
        {
          "type": "null"
        }
      ]
    },
    "mix": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "kind": {
      "enum": [
        "anchor",
        "procedural",
        "mixed",
        "multilingual",
        "near-duplicate",
        "stress"
      ]
    }
  }
}
