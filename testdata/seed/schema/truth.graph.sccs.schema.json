{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truth.graph.sccs.schema.json",
  "title": "One line of truth/graph/sccs.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "index",
    "size",
    "members",
    "planted"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "index": {
      "type": "integer",
      "minimum": 0
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/uuid"
      },
      "minItems": 1
    },
    "planted": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
