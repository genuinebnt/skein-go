{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "truth.graph.shortest_paths.schema.json",
  "title": "One line of truth/graph/shortest_paths.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "from",
    "to",
    "metric",
    "found",
    "distance",
    "path",
    "path_count",
    "unique",
    "truncated"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "from": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "to": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "metric": {
      "const": "PATH_METRIC_HOPS"
    },
    "found": {
      "type": "boolean"
    },
    "distance": {
      "type": "integer",
      "minimum": -1
    },
    "path": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/uuid"
          },
          "minItems": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "path_count": {
      "type": "integer",
      "minimum": 0
    },
    "unique": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  }
}
