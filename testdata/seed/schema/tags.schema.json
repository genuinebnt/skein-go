{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tags.schema.json",
  "title": "One line of tags.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "note_id",
    "tag"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "note_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "tag": {
      "type": "string",
      "minLength": 1
    }
  }
}
