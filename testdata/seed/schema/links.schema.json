{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "links.schema.json",
  "title": "One line of links.jsonl",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "source_note_id",
    "target_title",
    "target_note_id",
    "block_id",
    "added_at",
    "removed_at"
  ],
  "properties": {
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "source_note_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "target_title": {
      "type": "string",
      "minLength": 1
    },
    "target_note_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "block_id": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/blockId"
        },
        {
          "type": "null"
        }
      ]
    },
    "added_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "removed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
