{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "manifest.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "generator_version",
    "profile",
    "seed",
    "reference_time",
    "block_marker",
    "embedder",
    "counts",
    "files",
    "ops"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "generator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile": {
      "enum": [
        "small",
        "medium",
        "large",
        "stress"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "reference_time": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "block_marker": {
      "const": "\u001e"
    },
    "embedder": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "records",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z_/]+\\.jsonl?$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      },
      "minItems": 1
    },
    "ops": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "bytes",
        "digest"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    }
  }
}
