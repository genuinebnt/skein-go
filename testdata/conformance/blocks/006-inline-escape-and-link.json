{
  "name": "inline escape and link",
  "why": "A backslash before ASCII punctuation makes it literal (an escape node rendering the character), so the stars are not emphasis. [label](url) is a link whose label is parsed inline and whose url has no spaces.",
  "kind": "inline",
  "input": {
    "text": "\\*x\\* [doc](https://a.example)"
  },
  "expect": {
    "nodes": [
      {
        "kind": "escape",
        "start": 0,
        "end": 2,
        "content_start": 1,
        "content_end": 2,
        "value": "*"
      },
      {
        "kind": "text",
        "start": 2,
        "end": 3,
        "content_start": 2,
        "content_end": 3,
        "value": "x"
      },
      {
        "kind": "escape",
        "start": 3,
        "end": 5,
        "content_start": 4,
        "content_end": 5,
        "value": "*"
      },
      {
        "kind": "text",
        "start": 5,
        "end": 6,
        "content_start": 5,
        "content_end": 6,
        "value": " "
      },
      {
        "kind": "link",
        "start": 6,
        "end": 30,
        "content_start": 7,
        "content_end": 10,
        "value": "https://a.example",
        "children": [
          {
            "kind": "text",
            "start": 7,
            "end": 10,
            "content_start": 7,
            "content_end": 10,
            "value": "doc"
          }
        ]
      }
    ],
    "plain": "*x* doc",
    "links": [],
    "mentions": []
  }
}
