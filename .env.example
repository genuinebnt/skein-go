# Copy to .env for local runs. Values match deploy/compose.
DATABASE_URL_IDENTITY=postgres://identity:identity@localhost:5432/skein
DATABASE_URL_DOCUMENTS=postgres://documents:documents@localhost:5432/skein
DATABASE_URL_SEARCH=postgres://search:search@localhost:5432/skein
DATABASE_URL_ML=postgres://ml:ml@localhost:5432/skein
DATABASE_URL_AGENT=postgres://agent:agent@localhost:5432/skein
DATABASE_URL_NOTIFICATIONS=postgres://notifications:notifications@localhost:5432/skein
REDIS_URL=redis://localhost:6379
PUBSUB_EMULATOR_HOST=localhost:8085
PUBSUB_PROJECT=skein-local
SMTP_ADDR=localhost:1025
# The agent's model provider key; never commit a real one.
ANTHROPIC_API_KEY=
