{
  "name": "@skein/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Skein's browser client: the block editor, agent, search, discovery and graph explorer.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --mode mock",
    "dev:live": "vite --mode live",
    "build": "tsc -b && vite build --mode live",
    "build:mock": "tsc -b && vite build --mode mock --outDir dist-mock",
    "preview:mock": "vite preview --mode mock --outDir dist-mock --port 4173 --strictPort",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "gen:api": "node scripts/gen-api.mjs",
    "gen:seed": "node scripts/build-mock-seed.mjs",
    "wasm": "sh wasm/build.sh",
    "predev": "node scripts/build-mock-seed.mjs --if-missing && sh wasm/build.sh --if-missing",
    "pretest": "node scripts/build-mock-seed.mjs --if-missing && sh wasm/build.sh --if-missing",
    "prebuild:mock": "node scripts/build-mock-seed.mjs --if-missing && sh wasm/build.sh --if-missing"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "^17.14.0",
    "jsdom": "31.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
