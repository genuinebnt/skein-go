{
  "uid": "skein-service-overview",
  "title": "Skein / Service overview",
  "description": "RED (rate, errors, duration) per service and per method, from OpenTelemetry semantic conventions v1.45.0 RPC and HTTP metrics, plus cache and rate limiter health. Metric definitions: docs/observability.md.",
  "tags": [
    "skein",
    "red"
  ],
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Skein dashboards",
      "type": "dashboards",
      "tags": [
        "skein"
      ],
      "asDropdown": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(target_info{deployment_environment_name!=\"\"}, job)",
          "refId": "var-service",
          "qryType": 1
        },
        "definition": "label_values(target_info{deployment_environment_name!=\"\"}, job)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "rpc_method",
        "label": "gRPC method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(rpc_server_call_duration_seconds_count{job=~\"$service\"}, rpc_method)",
          "refId": "var-rpc_method",
          "qryType": 1
        },
        "definition": "label_values(rpc_server_call_duration_seconds_count{job=~\"$service\"}, rpc_method)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
