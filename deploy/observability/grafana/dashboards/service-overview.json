          "refId": "A",
          "expr": "sum by (job) (rate(rpc_server_call_duration_seconds_count{job=~\"$service\", rpc_method=~\"$rpc_method\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Server-fault ratio by service",
      "description": "Share of calls ending in a status code that means the server failed (UNKNOWN, DEADLINE_EXCEEDED, UNIMPLEMENTED, INTERNAL, UNAVAILABLE, DATA_LOSS). Client-caused codes such as INVALID_ARGUMENT or PERMISSION_DENIED are in the status-code panel, not here.",
      "id": 3,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
