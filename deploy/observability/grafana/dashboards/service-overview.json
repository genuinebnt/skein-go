      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (job) (rate(rpc_server_call_duration_seconds_count{job=~\"$service\", rpc_method=~\"$rpc_method\", rpc_status_code=~\"UNKNOWN|DEADLINE_EXCEEDED|UNIMPLEMENTED|INTERNAL|UNAVAILABLE|DATA_LOSS\"}[$__rate_interval])) / sum by (job) (rate(rpc_server_call_duration_seconds_count{job=~\"$service\", rpc_method=~\"$rpc_method\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true
