          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (messaging_destination_subscription_name, le) (rate(skein_consumer_process_duration_seconds_bucket{job=~\"$service\", messaging_destination_subscription_name=~\"$subscription\"}[$__rate_interval])))",
          "legendFormat": "{{messaging_destination_subscription_name}} p50",
