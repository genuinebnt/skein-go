      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (messaging_destination_subscription_name, skein_consumer_outcome) (rate(skein_consumer_process_duration_seconds_count{job=~\"$service\", messaging_destination_subscription_name=~\"$subscription\"}[$__rate_interval]))",
          "legendFormat": "{{messaging_destination_subscription_name}} {{skein_consumer_outcome}}",
          "range": true
        }
      ]
    },
