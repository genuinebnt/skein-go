    {
      "type": "stat",
      "title": "Dead letters in range",
      "description": "Messages consumers gave up on during the selected time range. Anything above zero needs a look at the .dead-letter topic.",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
