# Ports of the native stack (just dev, just prod-local, make up-native).
# Sourced by every script in deploy/local and by `make e2e`. Every value can be overridden from the
# environment. They are high and unusual so the native stack can run next
# to a Docker stack (make up) or anything else on the default ports.
#
# Convention: a service's gRPC port is 291NN and its admin HTTP port 281NN,
# with NN the last two digits of the port compose publishes it on.

# Infrastructure
: "${SKEIN_NATIVE_PG_PORT:=25432}"
: "${SKEIN_NATIVE_REDIS_PORT:=26379}"
: "${SKEIN_NATIVE_PUBSUB_PORT:=28085}"
: "${SKEIN_NATIVE_SMTP_PORT:=21025}"
: "${SKEIN_NATIVE_MAILPIT_PORT:=28025}"

# Services: gRPC, then admin HTTP (probes, JWKS)
: "${SKEIN_NATIVE_IDENTITY_GRPC:=29101}"
: "${SKEIN_NATIVE_IDENTITY_ADMIN:=28101}"
: "${SKEIN_NATIVE_DOCUMENTS_GRPC:=29102}"
: "${SKEIN_NATIVE_DOCUMENTS_ADMIN:=28102}"
: "${SKEIN_NATIVE_SEARCH_GRPC:=29103}"
: "${SKEIN_NATIVE_SEARCH_ADMIN:=28103}"
: "${SKEIN_NATIVE_NOTIFICATIONS_GRPC:=29104}"
: "${SKEIN_NATIVE_NOTIFICATIONS_ADMIN:=28104}"
: "${SKEIN_NATIVE_ML_GRPC:=29105}"
: "${SKEIN_NATIVE_ML_ADMIN:=28105}"
: "${SKEIN_NATIVE_AGENT_GRPC:=29107}"
: "${SKEIN_NATIVE_AGENT_ADMIN:=28107}"
: "${SKEIN_NATIVE_GATEWAY_HTTP:=28080}"

# The web app's dev server (just dev web, just web-live)
: "${SKEIN_NATIVE_WEB_PORT:=25173}"

# OpenTelemetry Collector (just prod-local): OTLP gRPC in, the collector's
# own metrics, and the services' metrics re-exported for Prometheus.
: "${SKEIN_NATIVE_OTLP_GRPC:=24317}"
: "${SKEIN_NATIVE_OTELCOL_METRICS:=28888}"
: "${SKEIN_NATIVE_OTELCOL_PROMETHEUS:=28889}"

export SKEIN_NATIVE_PG_PORT SKEIN_NATIVE_REDIS_PORT SKEIN_NATIVE_PUBSUB_PORT \
  SKEIN_NATIVE_SMTP_PORT SKEIN_NATIVE_MAILPIT_PORT \
  SKEIN_NATIVE_IDENTITY_GRPC SKEIN_NATIVE_IDENTITY_ADMIN \
  SKEIN_NATIVE_DOCUMENTS_GRPC SKEIN_NATIVE_DOCUMENTS_ADMIN \
  SKEIN_NATIVE_SEARCH_GRPC SKEIN_NATIVE_SEARCH_ADMIN \
  SKEIN_NATIVE_NOTIFICATIONS_GRPC SKEIN_NATIVE_NOTIFICATIONS_ADMIN \
  SKEIN_NATIVE_ML_GRPC SKEIN_NATIVE_ML_ADMIN \
  SKEIN_NATIVE_AGENT_GRPC SKEIN_NATIVE_AGENT_ADMIN \
  SKEIN_NATIVE_GATEWAY_HTTP SKEIN_NATIVE_WEB_PORT \
  SKEIN_NATIVE_OTLP_GRPC SKEIN_NATIVE_OTELCOL_METRICS SKEIN_NATIVE_OTELCOL_PROMETHEUS
